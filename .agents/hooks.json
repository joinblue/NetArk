{
  "netark-enterprise-guard": {
    "enabled": true,
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/netark_guard_daemon.py --session-start-mode agy --cwd ..",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|write_file|edit_file|write_to_file|replace_file_content|run_command|bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/netark_guard_daemon.py --hook-mode agy --cwd ..",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/netark_guard_daemon.py --post-hook-mode agy --cwd ..",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/netark_guard_daemon.py --stop-mode agy --cwd ..",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
