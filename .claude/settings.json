{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/netark_guard_daemon.py --session-start-mode claude --cwd ."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/netark_guard_daemon.py --hook-mode claude --cwd ."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/netark_guard_daemon.py --post-hook-mode claude --cwd ."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/netark_guard_daemon.py --stop-mode claude --cwd ."
          }
        ]
      }
    ]
  }
}
